  <TCPython KYID="C2A924CE-41E8-4DBC-80F8-0EC98CBD5F16" Name="加热棒" FolderID="30BD0066-988F-4FC7-9796-298024A2ED6A">
    <Code><![CDATA[import math,Manu
def VK(t, td, e1, e2):
      Dp = 0.05
      Di = 0.1
      Dd = 0.1
      e = td - t
      result = Dp * (e - e1) + Di * e + Dd * (e - 2*e1 + e2)

      return result

          
def Test(arg,exp):
      global e1     #上一次的e
      global e2    #上2次的e
      global v1
      print 'Hello world'
      seekresult=CH_232_加热棒.Clear()
      seekresult=CH_232_温度传感器.Clear()
      
      Protocol_温度传感器.温度值.Value=arg[3]
      bool=Protocol_温度传感器.Write()
      API.Common.Timer.Normal.Sleep(1000)
      if arg[0] == 1:
            e1 = arg[1] - arg[3]
      if arg[0] == 2:
            e2 = arg[1] - arg[3]
            Protocol_加热棒.BlockRead()
            v1 = Protocol_加热棒.加热棒输出电压.Value
      
      if arg[0] > 2:
            V = VK(arg[3], arg[1], e1, e2) + v1
            print VK(arg[3], arg[1], e1, e2) 
            print v1
            show=[]
            str = '设定温度为:%d,室温为：%f' % (arg[1], arg[3])
            show.append(str)
            str = '预期电压为:%f' % ( V )
            show.append(str)
            show.append('界面室温显示是否正确?')
            passed=Manu.Check(show)
            e2 = e1
            e1 = arg[1] - arg[3]
            Protocol_加热棒.BlockRead()
            v1 = Protocol_加热棒.加热棒输出电压.Value
           
      


Standard_Test(Test)]]></Code>
